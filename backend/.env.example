# All settings in this file are optional. Copy it to backend/.env to override
# defaults. Never commit backend/.env or place real API keys in this example.

# Set to false to use only TF-IDF/cosine similarity and avoid downloading the
# Sentence Transformers model on the first analysis.
ENABLE_SEMANTIC_SIMILARITY=true
SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# Optional CORE academic-paper importer.
CORE_API_KEY=
CORE_API_URL=https://api.core.ac.uk/v3/search/works/

# Optional local Ollama rewrites. Install Ollama and pull this model to enable
# it; the application falls back to its built-in rewriter when Ollama is absent.
OLLAMA_MODEL=gemma2:2b

# Optional provider settings retained by the correction service.
GEMINI_API_KEY=
GEMINI_REWRITE_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
